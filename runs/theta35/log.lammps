  (1) pair granular, perpetual
      attributes: half, newton on, size, history
      pair build: half/size/bin/atomonly/newton
      stencil: half/bin/2d
      bin: standard
  (2) compute contact/atom, occasional, copy from (1)
      attributes: half, newton on, size
      pair build: copy
      stencil: none
      bin: none
